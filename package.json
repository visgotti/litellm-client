{
  "name": "litellm-proxy",
  "version": "0.1.0",
  "description": "Production-grade TypeScript client for the LiteLLM proxy server. Zero runtime dependencies.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "lint": "tsc --noEmit",
    "test": "jest --config jest.config.ts --group=-e2e",
    "test:unit": "jest --config jest.config.ts --group=-e2e --coverage",
    "test:e2e": "jest --config jest.e2e.config.ts --group=e2e --runInBand --verbose",
    "test:e2e:setup": "docker compose -f tests/e2e/docker-compose.yml up -d --wait",
    "test:e2e:teardown": "docker compose -f tests/e2e/docker-compose.yml down -v",
    "test:coverage": "jest --config jest.config.ts --group=-e2e --coverage --coverageReporters=lcov --coverageReporters=text",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "litellm",
    "proxy",
    "llm",
    "openai",
    "ai",
    "typescript",
    "client"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_ORG/litellm-proxy.git"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "jest-runner-groups": "^2.2.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
